QWidget {
  background-color: #1a0022;
}

QLabel#page-title {
  color: #e600ff;
  font-size: 16px;
  font-style: italic;
  font-weight: bold;
  letter-spacing: 0.1em;
  word-spacing: 0.1em;
}

QWidget#wrapper {
  border: none;
  background-color: transparent;
}